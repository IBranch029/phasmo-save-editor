{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhasmoSave Editor",
  "version": "1.0.0",
  "identifier": "com.phasmophobia.phasmosaveeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PhasmoSave Editor",
        "width": 1360,
        "height": 880,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "center": true,
        "focus": true,
        "theme": "Dark",
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Phasmophobia save editor",
    "longDescription": "Edit money, experience, prestige level and equipment of your local Phasmophobia profile save file.",
    "copyright": "PhasmoSave Editor",
    "publisher": "PhasmoSave Editor",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}

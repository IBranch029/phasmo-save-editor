# Normalise line endings in the repository, check out with LF everywhere.
* text=auto eol=lf

# Windows scripts need CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets must never be touched.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.woff binary
*.woff2 binary
*.ttf binary

# Lock files are checked in but must stay untouched.
package-lock.json -diff linguist-generated=true
src-tauri/Cargo.lock -diff linguist-generated=true
